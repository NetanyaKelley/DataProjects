                  <img style=""width: 166.7px; height: 80.0px; margin: 0 auto"" width=""166"" height=""80"" src=""https://app.pinpointhq.com/rails/active_storage/representations/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaHBCRkY4RVFRPSIsImV4cCI6bnVsbCwicHVyIjoiYmxvYl9pZCJ9fQ==--5b4d58ca9f0f4717635ec8791803320023b3fd8f/eyJfcmFpbHMiOnsibWVzc2FnZSI6IkJBaDdCam9MY21WemFYcGxTU0lRTkRBd0xqQjRNVFl3TGpBR09nWkZWQT09IiwiZXhwIjpudWxsLCJwdXIiOiJ2YXJpYXRpb24ifX0=--bfd553d5c851881d3cf8eee41207d8aed2ab8013/NAIK_Trans_A_Large.png"" />

                  <tr>
  <td align=""center"" valign=""top"" colspan=""12"" style=""text-align:center"">
    <table width=""600"" border=""0"" cellspacing=""0"" cellpadding=""0"" class=""containerWidth"">
      <tr>
        <a href=""https://ejep.fa.us2.oraclecloud.com:443/hcmUI/CandidateExperience/ircEmailPreview?referenceId=enc2%3A70Ku3Uc3SthslnNwUo6VTlA2WZVIkmB3JgwKBmnZTQ%3D%3D"">View in Browser</a>
      </tr>

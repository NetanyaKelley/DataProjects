<td style=""text-align:center;vertical-align:top;font-size:0px;padding:20px 0px;"">

<!--[if mso | IE]><table role=""presentation"" border=""0"" cellpadding=""0"" cellspacing=""0""><tr><td style=""vertical-align:top;width:600px;""><![endif]-->

<div style=""vertical-align:top;display:inline-block;font-size:13px;text-align:left;width:100%;""class=""mj-column-per-100"" aria-labelledby=""mj-column-per-100""><table border=""0"" width=""100%"" cellspacing=""0"" cellpadding=""0"" >
<tbody>
<tr>
<td align=""center"" style=""word-break:break-word;font-size:0px;padding-bottom:0px;""><div style=""cursor:auto;color:#98a0a6;font-family:Roboto;font-size:12px;font-weight:400;line-height:22px;"">This email was intended for netanyakelley6@gmail.com <br>This message was sent from an unmonitored address. Please do not respond to this message. For assistance, please contact the Sanford Employee Service Center at (877) 949-5678. Sanford <span>&#8226;</span> https://www.sanfordhealth.org </div>
</td>
</tr>

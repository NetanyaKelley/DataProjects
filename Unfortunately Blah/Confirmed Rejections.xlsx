px;padding:0;position:relative;text-align:left;vertical-align:top;width:100%""><tbody><tr style=""padding:0;text-align:left;vertical-align:top""><th class=""jv-logo-col small-12 large-12 columns first last"" height=""100"" valign=""middle"" style=""Margin:0 auto;color:#0a0a0a;font-family:Helvetica,Arial,sans-serif;font-size:16px;font-weight:400;line-height:1.3;margin:0 auto;margin-bottom:0!important;padding:0;padding-bottom:0!important;padding-left:0!important;padding-right:16px;text-align:left;width:-zf-grid-calc-pct(12,12)""><table style=""border-collapse:collapse;border-spacing:0;padding:0;text-align:left;vertical-align:top;width:100%""><tbody><tr style=""padding:0;text-align:left;vertical-align:top""><th style=""Margin:0;color:#0a0a0a;font-family:Helvetica,Arial,sans-serif;font-size:16px;font-weight:400;line-height:1.3;margin:0;padding:0;text-align:left""><img class=""jv-logo"" style=""-ms-interpolation-mode:bicubic;clear:both;display:block;max-height:50px;max-width:100%;outline:0;text-decoration:none;width:auto"" alt=""Enverus"" height=""50"" src=""https://d3igejkwe1ucjd.cloudfront.net/company/qpZaVfwd/assets/email/images/file/EnverusLogoCMYKCopy_1571843067455.jpg""></th><th class=""expander"" style=""Margin:0;color:#0a0a0a;font-family:Helvetica,Arial,sans-serif;font-size:16px;font-weight:400;line-height:1.3;margin:0;padding:0!important;text-align:left;visibility:hidden;width:0""></th></tr></tbody></table></th></tr></tbody></table>  <p>Dear Netanya,<br /><br />We sincerely thank you for your time and interest in the Data Specialist - 26327 position with Enverus. <br /><br />We had a large amount of interest in this position. After reviewing resumes, we have made the decision to move forward with other candidates. <br /><br />We will keep you in mind for other opportunities and encourage you to check our careers site for future openings!<br /><br />Again, thank you for your interest in employment with Enverus.<br /><br />Sincerely,<br /><br />The Enverus Recruit
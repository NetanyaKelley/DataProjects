    <link href=""https://static.workforcenow.adp.com/mas/mdf-components/25.14.30/styles/froala_editor.pkgd.min.css"" rel=""stylesheet"" type=""text/css"" />
    <link href=""https://static.workforcenow.adp.com/mas/mdf-components/25.14.30/styles/froala_style.min.css"" rel=""stylesheet"" type=""text/css"" />

    <div class=""fr-view"">
      <p><link href=""https://static.workforcenow.adp.com/mas/mdf-components/23.37.26/styles/froala_editor.pkgd.min.css"" rel=""stylesheet"" type=""text/css""><link href=""https://static.workforcenow.adp.com/mas/mdf-components/23.37.26/styles/froala_style.min.css"" rel=""stylesheet"" type=""text/css""></p><div class=""fr-view""><link href=""https://static.workforcenow.adp.com/mas/mdf-components/23.14.30/styles/froala_editor.pkgd.min.css"" rel=""stylesheet"" type=""text/css""><span style='font-family: ""times new roman"", serif; font-size: 16px;'> <link href=""https://static.workforcenow.adp.com/mas/mdf-components/23.14.30/styles/froala_style.min.css"" rel=""stylesheet"" type=""text/css""></span><div class=""fr-view""><span style='font-family: ""times new roman"", serif; font-size: 16px;'><link href=""https://static.workforcenow.adp.com/mas/mdf-components/23.14.30/styles/froala_editor.pkgd.min.css"" rel=""stylesheet"" type=""text/css""><link href=""https://static.workforcenow.adp.com/mas/mdf-components/23.14.30/styles/froala_style.min.css"" rel=""stylesheet"" type=""text/css""></span><div class=""fr-view""><span style='font-family: ""times new roman"", serif; font-size: 16px;'><link href=""https://static.workforcenow.adp.com/mas/mdf-components/23.14.30/styles/froala_editor.pkgd.min.css"" rel=""stylesheet"" type=""text/css""></span><div class=""fr-view""><span style='font-family: ""times new roman"", serif; font-size: 16px;'>Hello </span><span class=""fr-deletable"" contenteditable=""false"" oid=""SYS:WFN23:2272509"" label=""Candidate First Name"" datatype=""Text"" comboservice=""undefined"">Netanya</span><span style='font-family: ""times new roman"", serif; font-size: 16px;'>,<br><br></span><div class=""fr-view""><span style='font-family: ""times new roman"", serif; font-size: 16px;'>Thank you for applying with </span><span class=""fr-deletable"" contenteditable=""false"" oid=""SYS:WFN23:2272513"" label=""Company Name"" datatype=""Text"" comboservice=""undefined"">Concierge Home Care</span><span style='font-family: ""times new roman"", serif; font-size: 16px;'>. A great deal of thought and consideration went into reviewing the qualifications of all who applied. At this time, we have decided to move forward with other candidates for the role. Thank you again for your interest in our team. </span><span style='font-size: 16px; font-family: ""times new roman"", serif; color: black; background: white;' id=""isPasted"">Please feel free to join our Talent Community to be one of the first notified of new opportunities. Thank you for your time, and we wish you all the best in your future endeavors. </span><span style='font-size: 16px; font-family: ""times new roman"", serif; color: black;'><br style="" border-box;font-variant-ligatures: normal;font-variant-caps: normal;orphans: 2;text-align:start;widows: 2;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;word-spacing:0px;""> <span style=""background: white;""> </span><br style="" border-box;font-variant-ligatures: normal;font-variant-caps: normal;orphans: 2;text-align:start;widows: 2;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;word-spacing:0px;""> <span style=""background: white;"">With Gratitude,</span><br style="" border-box;font-variant-ligatures: normal;font-variant-caps: normal;orphans: 2;text-align:start;widows: 2;-webkit-text-stroke-width: 0px;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;word-spacing:0px;""> <span style=""background: white;"">The Talent Acquisition Department</span><br> <br></span><span style='font-size: 16px; font-family: ""times new roman"", serif; color: black; background: white;'>Join the Talent Community</span><span style='font-size: 16px; font-family: ""times new roman"", serif; color: black;'> <br></span><span style='font-size: 16px; font-family: ""times new roman"", serif; color: black; background: white;'><a href=""https://81hmpnd6.r.us-east-1.awstrack.me/L0/https:%2F%2Fworkforcenow.adp.com%2Fmascsr%2Fdefault%2Fmdf%2Frecruitment%2Frecruitment.html%3Fcid=ce2f2d73-4f05-4dc0-bee5-c701d2b36516%26ccId=19000101_000001%26lang=en_US/1/0100019c6c5f5016-b3926eb7-6efb-402a-989b-1aa672307fd7-000000/pof27bXLFcSa8FgToJQOneVPToE=465"" target=""_blank""><span style=""color: blue;"">https://workforcenow.adp.com/mascsr/default/mdf/recruitment/recruitment.html?cid=ce2f2d73-4f05-4dc0-bee5-c701d2b36516&ccId=19000101_000001&lang=en_US</span></a></span><br><style>p {margin-block-start: 0em !important; margin-block-end: 0em !important;}</style></div></div></div></div></div>

</table><table width=""600"" border=""0"" cellspacing=""0"" cellpadding=""0"" bgcolor=""#ffffff"" class=""containerWidth"">
    <tr>
        <td class=""image-column"" align=""left"" style=""padding-top:0;padding-bottom:0;padding-right:0;padding-left:0;display:block;"">           
            <img width=""250"" height=""60"" class=""imageFix"" src=""https://www1.deltadentalins.com/content/dam/ddins/en/talent-acq/ddins-logo-talent-acq.png"" style=""max-width:600px !important;max-height:60px !important""/>
        </td>

  .series-article-body [data-type=""entityEmbed""] .pub-entity-img {
    width: 48px;
  }
}
@media (max-width: 767px) {
  .series-article-body [data-type=""entityEmbed""][data-entity-type=""organization""] .pub-entity-img img {
    height: 48px;

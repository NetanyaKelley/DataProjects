eight:0px;font-size:0px;mso-line-height-url:exactly;""><![endif]--><div style=""margin:0px auto;max-width:600px;""><table align=""center"" border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""width:100%;"" ><tbody><tr><td style=""direction:ltr;font-size:0px;padding:0px;text-align:center;display:table;width:100%;""><!--[if mso | IE]><table role=""presentation"" border=""0"" cellpadding=""0"" cellspacing=""0"" ><![endif]--><!--[if mso | IE]><tr><![endif]--><!--[if mso | IE]><td style=""vertical-align:top;width:600px;background-color:#ffffff;"" ><![endif]--><div style=""font-size:0px;text-align:left;display:table-cell;direction:ltr;vertical-align:top;width:100%;background-color:#ffffff;padding:5px;"" class=""mj-column-per-100-0 mj-outlook-group-fix"" ><table border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""vertical-align:top;background-color:#ffffff;padding:5px;"" width=""100%"" ><tr><td align=""left"" style=""font-size:0px;word-break:break-word;direction:ltr;"" ><div style=""font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:1.15;text-align:left;color:#494949;word-break:break-word;""><p>While this email is automatically generated, our review process is not. Here is what will happen next:</p><p>Our Talent Acquisition Team is working hard to review every resume/CV submitted to us and identify the strongest candidates to move forward in the process. Additionally, you can always check the status of your application for this position by visiting your Candidate Home page by clicking the button below. </p></div></td></tr></table></div><!--[if mso | IE]></td><![endif]--><!--[if mso | IE]><![endif]--><!--[if mso | IE]></table><![endif]--></td></tr></tbody></table></div><!--[if mso | IE]></td></tr></table><![endif]--><!--[if mso | IE]><table align=""center"" border=""0"" cellpadding=""0"" cellspacing=""0"" style=""width:600px;"" width=""600px"" ><tr><td style=""line-height:0px;font-size:0px;mso-line-height-url:exactly;""><![endif]--><div style=""margin:0px auto;max-width:600px;""><table align=""center"" border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""width:100%;"" ><tbody><tr><td style=""direction:ltr;font-size:0px;padding:0px;text-align:center;display:table;width:100%;""><!--[if mso | IE]><table role=""presentation"" border=""0"" cellpadding=""0"" cellspacing=""0"" ><![endif]--><!--[if mso | IE]><tr><![endif]--><!--[if mso | IE]><td style=""vertical-align:middle;width:600px;background-color:#ffffff;"" ><![endif]--><div style=""font-size:0px;text-align:left;display:table-cell;direction:ltr;vertical-align:middle;width:100%;background-color:#ffffff;padding:10px;"" class=""mj-column-per-100-0 mj-outlook-group-fix"" ><table border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""vertical-align:middle;background-color:#ffffff;padding:10px;"" width=""100%"" ><tr><td align=""center"" vertical-align=""middle"" style=""font-size:0px;word-break:break-word;direction:ltr;"" ><table border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""border-collapse:separate;line-height:100%;"" ><tr><td align=""center"" role=""presentation"" bgcolor=""#005cb9"" style=""border:none;border-radius:0px;cursor:auto;mso-padding-alt:10px 25px;text-align:center;background:#005cb9;"" valign=""middle"" ><a href=""https://assurant.wd1.myworkdayjobs.com/Assurant_Careers"" style=""display:inline-block;background:#005cb9;color:#ffffff;font-family:Arial, Helvetica, sans-serif;font-size:14px;font-weight:600;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:12px 24px;mso-padding-alt:0px;border-radius:0px;"" target=""_blank"" ><span>Candidate Home Page</span></a></td></tr></table></td></tr></table></div><!--[if mso | IE]></td><![endif]--><!--[if mso | IE]><![endif]--><!--[if mso | IE]></table><![endif]--></td></tr></tbody></table></div><!--[if mso | IE]></td></tr></table><![endif]--><!--[if mso | IE]><table al
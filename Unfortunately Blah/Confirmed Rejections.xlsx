[if mso | IE]></table><![endif]--></td></tr></tbody></table></div><!--[if mso | IE]></td></tr></table><![endif]--><!--[if mso | IE]><table align=""center"" border=""0"" cellpadding=""0"" cellspacing=""0"" style=""width:600px;"" width=""600px"" ><tr><td style=""line-height:0px;font-size:0px;mso-line-height-url:exactly;""><![endif]--><div style=""margin:0px auto;max-width:600px;""><table align=""center"" border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""width:100%;"" ><tbody><tr><td style=""direction:ltr;font-size:0px;padding:0px;text-align:center;display:table;width:100%;""><!--[if mso | IE]><table role=""presentation"" border=""0"" cellpadding=""0"" cellspacing=""0"" ><![endif]--><!--[if mso | IE]><tr><![endif]--><!--[if mso | IE]><td style=""vertical-align:middle;width:300px;background-color:#ffffff;"" ><![endif]--><div style=""font-size:0px;text-align:left;display:table-cell;direction:ltr;vertical-align:middle;width:50%;background-color:#ffffff;padding:10px;"" class=""mj-column-per-50-0 mj-outlook-group-fix"" ><table border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""vertical-align:middle;background-color:#ffffff;padding:10px;"" width=""100%"" ><tr><td align=""center"" vertical-align=""middle"" style=""font-size:0px;word-break:break-word;direction:ltr;"" ><table border=""0"" cellpadding=""0"" cellspacing=""0"" role=""presentation"" style=""border-collapse:separate;line-height:100%;"" ><tr><td align=""center"" role=""presentation"" bgcolor=""#005cb9"" style=""border:none;border-radius:0px;cursor:auto;mso-padding-alt:10px 25px;text-align:center;background:#005cb9;"" valign=""middle"" ><a href=""https://jobs.assurant.com/en/job-application-process"" style=""display:inline-block;background:#005cb9;color:#ffffff;font-family:Arial, Helvetica, sans-serif;font-size:14px;font-weight:600;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:12px 24px;mso-padding-alt:0px;border-radius:0px;"" target